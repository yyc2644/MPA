{
    "interface_version": 2,
    "name": "MPA",
    "languages": {
        "zh_cn": "resource/base/lang/zh_cn.json",
        "en_us": "resource/base/lang/en_us.json"
    },
    "label": "$app.label",
    "title": "$app.title",
    "version": "v0.0.1",
    "icon": "resource/base/image/logo.png",
    "github": "https://github.com/yyc2644/MPA",
    "contact": "$app.contact",
    "license": "LICENSE",
    "welcome": "resource/base/docs/welcome.md",
    "description": "resource/base/docs/about.md",
    "controller": [
        {
            "name": "android",
            "type": "Adb",
            "label": "$controller.android.label",
            "description": "$controller.android.description",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "base",
            "label": "$resource.base.label",
            "description": "$resource.base.description",
            "icon": "resource/base/image/logo.png",
            "path": [
                "resource/base"
            ],
            "controller": [
                "android"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "agent/main.py",
            "{identifier}"
        ]
    },
    "task": [
        {
            "name": "daily_routine",
            "label": "$task.daily_routine.label",
            "entry": "DailyRoutine",
            "default_check": true,
            "description": "$task.daily_routine.description",
            "doc": "resource/base/docs/tasks/daily_routine.md"
        },
        {
            "name": "startup",
            "label": "$task.startup.label",
            "entry": "StartUp",
            "description": "$task.startup.description"
        },
        {
            "name": "stop",
            "label": "$task.stop.label",
            "entry": "StopPTCG"
        },
        {
            "name": "account_bootstrap",
            "label": "$task.account_bootstrap.label",
            "entry": "AccountBootstrap",
            "description": "$task.account_bootstrap.description",
            "doc": "resource/base/docs/tasks/account_bootstrap.md"
        },
        {
            "name": "gacha",
            "label": "$task.gacha.label",
            "entry": "Gacha",
            "description": "$task.gacha.description",
            "doc": "resource/base/docs/tasks/gacha.md"
        },
        {
            "name": "wonder_pick",
            "label": "$task.wonder_pick.label",
            "entry": "WonderPick",
            "description": "$task.wonder_pick.description",
            "doc": "resource/base/docs/tasks/daily_routine.md"
        },
        {
            "name": "claim_gifts",
            "label": "$task.claim_gifts.label",
            "entry": "ClaimGifts",
            "description": "$task.claim_gifts.description",
            "doc": "resource/base/docs/tasks/daily_routine.md"
        },
        {
            "name": "shop_free",
            "label": "$task.shop_free.label",
            "entry": "ShopFree",
            "description": "$task.shop_free.description",
            "doc": "resource/base/docs/tasks/daily_routine.md"
        },
        {
            "name": "claim_missions",
            "label": "$task.claim_missions.label",
            "entry": "ClaimMissions",
            "description": "$task.claim_missions.description",
            "doc": "resource/base/docs/tasks/daily_routine.md"
        },
        {
            "name": "solo_battle",
            "label": "$task.solo_battle.label",
            "entry": "SoloBattle",
            "description": "$task.solo_battle.description",
            "doc": "resource/base/docs/tasks/battle.md"
        },
        {
            "name": "versus_battle",
            "label": "$task.versus_battle.label",
            "entry": "VersusBattle",
            "description": "$task.versus_battle.description",
            "doc": "resource/base/docs/tasks/battle.md"
        },
        {
            "name": "share_card",
            "label": "$task.share_card.label",
            "entry": "ShareCard",
            "description": "$task.share_card.description",
            "doc": "resource/base/docs/tasks/social.md"
        },
        {
            "name": "trade_card",
            "label": "$task.trade_card.label",
            "entry": "TradeCard",
            "description": "$task.trade_card.description",
            "doc": "resource/base/docs/tasks/social.md"
        }
    ]
}
