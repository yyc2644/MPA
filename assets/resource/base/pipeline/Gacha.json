        ]
    },
    "SwipeGacha": {
        // Keep the gesture away from the Android edge area. The following
        // candidates verify success before a sealed-pack retry is allowed.
        "action": "Swipe",
        "begin": [
            120,
            742
        ],
        "end": [
            670,
            742
        ],
        "duration": 300,
        "end_hold": 50,
        "post_delay": 1500,
        "timeout": 12000,
        "on_error": [
            "GachaSwipeFailed"
        ],
        "next": [
            "SkipGacha",
            "ClickContinue",
            "ClickSkip",
            "GachaOver",
            "SwipeGachaRetry1"
        ]
    },
    "SwipeGachaRetry1": {
        // Always perform another left-to-right retry. During a failed cut,
        // the prompt briefly disappears while the seal flashes, so checking
        // it here would produce a false success.
        "recognition": "DirectHit",
        "max_hit": 1,
        "action": "Swipe",
        "begin": [
            110,
            742
        ],
        "end": [
            680,
            742
        ],
        "duration": 450,
        "end_hold": 80,
        "post_delay": 1500,
        "timeout": 12000,
        "on_error": [
            "GachaSwipeFailed"
        ],
        "next": [
            "SkipGacha",
            "ClickContinue",
            "ClickSkip",
            "GachaOver",
            "SwipeGachaRetry2"
        ]
    },
    "SwipeGachaRetry2": {
        "recognition": "DirectHit",
        "max_hit": 1,
        "action": "Swipe",
        "begin": [
            100,
            750
        ],
        "end": [
            690,
            750
        ],
        "duration": 650,
        "end_hold": 120,
        // A rejected cut can keep the seal glowing for several seconds before
        // the instruction returns. Judge the final state only after it settles.
        "post_delay": 8000,
        "timeout": 20000,
        "on_error": [
            "GachaSwipeFailed"
        ],
        "next": [
            "SkipGacha",
            "ClickContinue",
            "ClickSkip",
            "GachaOver",
            "GachaSwipeStillSealed",
            "GachaSwipeOpened"
        ]
    },
