    "WonderPickScroll": {
        "recognition": "DirectHit",
        // The counter spans the whole task. Twelve swipes cover repeated
        // searches after several successful picks while remaining bounded.
        "max_hit": 12,
        "action": "Swipe",
        "begin": [
            680,
            1000
        ],
        "end": [
            680,
            350
        ],
        "duration": 650,
        "post_delay": 1800,
        "next": [
            "WonderPickHighCostIcon",
            "WonderPickScroll",
            "WonderPickFallbackReset1"
        ]
    },
    "WonderPickFallbackReset1": {
        // Preferred targets are exhausted or unaffordable. Return to the top
