{
    "WonderPick": {
        "next": [
            "[JumpBack]WonderPickStartUp",
            "WonderPickOpenEntry"
        ]
    },
    "WonderPickStartUp": {
        "max_hit": 1,
        "action": "DoNothing",
        "next": [
            "StartUp"
        ]
    },
    "WonderPickOpenEntry": {
        "recognition": "OCR",
        "roi": [
            90,
            900,
            250,
            130
        ],
        "expected": "得卡挑[戰战]",
        "threshold": 0.65,
        "action": "Click",
        "target": [
            190,
            970
        ],
        "post_delay": 7000,
        "next": [
            "WonderPickListReady"
        ]
    },
    "WonderPickListReady": {
        "recognition": "OCR",
        "roi": [
            210,
            35,
            300,
            110
        ],
        "expected": "得卡挑[戰战]",
        "threshold": 0.65,
        "action": "DoNothing",
        "next": [
            "WonderPickScanFree"
        ]
    },
    "WonderPickScanFree": {
        // Bonus Picks are pinned before normal groups and show Free/免費 at the
        // bottom of the panel. Always consume these before spending stamina.
        "recognition": "OCR",
        "roi": [
            240,
            930,
            240,
            80
        ],
        "expected": "^[Ff][Rr][Ee][Ee]$|免[費费]|不消耗|No.?cost",
        "threshold": 0.45,
        "only_rec": true,
        "action": "Click",
        "target": [
            360,
            600
        ],
        "post_delay": 3000,
        "next": [
            "WonderPickConfirmFree"
        ],
        "on_error": [
            "WonderPickStrategyEntry"
        ]
    },
    "WonderPickConfirmFree": {
        // Recheck the detail page so a stale/expired panel can never fall
        // through to a paid Wonder Pick.
        "recognition": "OCR",
        "roi": [
            70,
            1020,
            320,
            120
        ],
        "expected": "^[Ff][Rr][Ee][Ee]$|免[費费]|不消耗|No.?cost|^0$",
        "threshold": 0.4,
        "only_rec": true,
        "action": "Click",
        "target": [
            520,
            1090
        ],
        "post_delay": 9000,
        "next": [
            "WonderPickChooseFreeCard"
        ],
        "on_error": [
            "WonderPickRefreshExpired",
            "WonderPickFreeConfirmFailed"
        ]
    },
    "WonderPickRefreshExpired": {
        "recognition": "OCR",
        "roi": [
            150,
            500,
            420,
            190
        ],
        "expected": "得卡挑[戰战]的更新時間到了|得卡挑[戰战]的更新时间到了",
        "threshold": 0.55,
        "action": "Click",
        "target": [
            360,
            850
        ],
        "post_delay": 5000,
        "next": [
            "WonderPickListReady"
        ]
    },
    "WonderPickFreeConfirmFailed": {
        "action": "StopTask",
        "focus": "WonderPickFreeConfirmFailed",
        "attach": {
            "reason": "A free Wonder Pick was selected, but the detail page could not be verified as free. No confirmation was pressed."
        }
    },
    "WonderPickStrategyEntry": {
        // The frontend overrides this route for each strategy.
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": [
            "WonderPickScanHighRarity"
        ]
    },
    "WonderPickScanHighRarity": {
        // A displayed cost of 3 or 4 is used as the stable proxy for a group
        // containing a one-star-or-higher card. The final card is still random.
        "recognition": "OCR",
        "roi": [
            365,
            920,
            55,
            75
        ],
        "expected": "^4$",
        "threshold": 0.2,
        "only_rec": true,
        "action": "Click",
        "target": [
            360,
            600
        ],
        "post_delay": 3000,
        "next": [
            "WonderPickConfirmRemaining4"
        ],
        "on_error": [
            "WonderPickScanHighRarityLower"
        ]
    },
