{
    "WonderPick": {
        "next": [
            "[JumpBack]WonderPickStartUp",
            "WonderPickOpenEntry"
        ]
    },
    "WonderPickStartUp": {
        "max_hit": 1,
        "action": "DoNothing",
        "next": [
            "StartUp"
        ]
    },
    "WonderPickOpenEntry": {
        "recognition": "OCR",
        "roi": [
            90,
            900,
            250,
            130
        ],
        "expected": "得卡挑[戰战]",
        "threshold": 0.65,
        "action": "Click",
        "target": [
            190,
            970
        ],
        "post_delay": 7000,
        "next": [
            "WonderPickListReady"
        ]
    },
    "WonderPickListReady": {
        "recognition": "OCR",
        "roi": [
            210,
            35,
            300,
            110
        ],
        "expected": "得卡挑[戰战]",
        "threshold": 0.65,
        "action": "DoNothing",
        "next": [
            "WonderPickScanFree",
            "WonderPickStrategyEntry"
        ]
    },
    "WonderPickScanFree": {
        // Bonus Picks are pinned before normal groups. The large localized
        // title is substantially more stable than the small English "Free"
        // label, which the OCR model can read as "Cre" on this screen.
        "recognition": "OCR",
        // Multiple free picks can coexist, but a stale list entry must not be
        // re-entered forever.
        "max_hit": 5,
        "roi": [
            180,
            255,
            360,
            120
        ],
        "expected": "^免.{2,4}$|Bonus.?Pick|Free.?Pick",
        "threshold": 0.2,
        "only_rec": true,
        "action": "Click",
        "target": [
            360,
            600
        ],
        "post_delay": 3000,
        "next": [
            "WonderPickConfirmFree"
        ],
        "on_error": [
            "WonderPickStrategyEntry"
        ]
    },
    "WonderPickConfirmFree": {
        // Recheck the detail page so a stale/expired panel can never fall
        // through to a paid Wonder Pick.
        "recognition": "OCR",
        "roi": [
            70,
            1020,
            320,
            120
        ],
        // The stylized white "Free" label is commonly OCRed as "Cre" or
        // "re.". Keep the check inside the cost-label ROI so paid picks
        // can never satisfy this guard.
        "expected": "^[FfCc]?[Rr][Ee][Ee.]?$|免[費费]|不消耗|No.?cost|^0$",
        "threshold": 0.3,
        "only_rec": true,
        "action": "Click",
        "target": [
            520,
            1090
        ],
        "post_delay": 9000,
        "next": [
            "WonderPickChooseFreeCard"
        ],
        "on_error": [
            "WonderPickRefreshExpired",
            "WonderPickFreeConfirmFailed"
        ]
    },
    "WonderPickRefreshExpired": {
        "recognition": "OCR",
        "roi": [
            150,
            500,
            420,
            190
        ],
        "expected": "得卡挑[戰战]的更新時間到了|得卡挑[戰战]的更新时间到了",
        "threshold": 0.55,
        "action": "Click",
        "target": [
            360,
            850
        ],
        "post_delay": 5000,
        "next": [
            "WonderPickListReady"
        ]
    },
    "WonderPickFreeConfirmFailed": {
        "action": "StopTask",
        "focus": "WonderPickFreeConfirmFailed",
        "attach": {
            "reason": "A free Wonder Pick was selected, but the detail page could not be verified as free. No confirmation was pressed."
        }
    },
    "WonderPickStrategyEntry": {
        // The frontend overrides this route for each strategy.
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": [
            "WonderPickHighCostIcon",
            "WonderPickScroll",
            "WonderPickFallbackReset1"
        ]
    },
    "WonderPickHighCostIcon": {
        // Anchor the OCR to the orange Wonder Pick stamina icon. Its vertical
        // position changes as the list scrolls, while the digit is always just
        // to the right of this icon.
        "recognition": "TemplateMatch",
        "roi": [
            250,
            230,
            220,
            850
        ],
        "template": "wonder_pick_cost_icon.png",
        "threshold": 0.82,
        "order_by": "Vertical",
        "action": "DoNothing",
        "next": [
            "WonderPickScanHighRarity",
            "WonderPickScanHighRarity3",
            "WonderPickScroll",
            "WonderPickFallbackReset1"
        ]
    },
    "WonderPickScanHighRarity": {
        // A displayed cost of 3 or 4 is used as the stable proxy for a group
        // containing a one-star-or-higher card. The final card is still random.
        "recognition": "OCR",
        "roi": "WonderPickHighCostIcon",
        "roi_offset": [
            42,
            -5,
            5,
            10
        ],
        "expected": "^4$",
        "threshold": 0.2,
        "only_rec": true,
        "action": "Click",
        "target": "WonderPickHighCostIcon",
        // Clicking the cost badge itself does not open the group. A point just
        // above it is always inside the group's card panel, even after scrolling.
        "target_offset": [
            0,
            -90,
            0,
            0
        ],
        "post_delay": 3000,
        "next": [
            "WonderPickDetailExpired",
            "WonderPickConfirmRemaining4"
        ],
        "on_error": [
            "WonderPickScanHighRarity3"
        ]
    },
    "WonderPickScanHighRarity3": {
        // Single stylized digits are too small for OCR on several devices, so
        // match the rendered cost digit relative to the stamina-icon anchor.
        "recognition": "TemplateMatch",
        "roi": "WonderPickHighCostIcon",
        "roi_offset": [
            42,
            -5,
            5,
            10
        ],
        "template": "wonder_pick_cost_3.png",
        "threshold": 0.78,
        "action": "Click",
        "target": "WonderPickHighCostIcon",
        "target_offset": [
            0,
            -90,
            0,
            0
        ],
        "post_delay": 3000,
        "next": [
            "WonderPickDetailExpired",
            "WonderPickConfirmRemaining3"
