    "StopPTCG": {
        // Returning from a pack or Wonder Pick page can display the home
        // notification after a short loading screen.
        "post_delay": 5000,
        "action": "StopApp",
        "package": "jp.pokemon.pokemontcgp"
    },
    "BackMain": {
        "max_hit": 5,
        // The same home glyph is outlined during transitions and filled while
        // the pack page is active; the filled variant scores about 0.626.
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    30,
                    1190,
                    140,
                    80
                ],
                "template": "start_up/home_default.png",
                "threshold": 0.6
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 1000,
        "next": [
            "CheckMain"
        ]
    },
    "CloseNotify": {
        "max_hit": 3,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    337,
                    1131,
                    50,
                    50
                ],
                "template": "start_up/close_notify.png"
            }
        },
        "threshold": 0.8,
        // "only_rec": true,
        "action": {
            "type": "Click"
        },
        "post_delay": 1000,
        "next": [
            "CheckMain"
        ]
    },
    "ClosePackIndex": {
        // The booster-pack selector is a full-screen sheet and hides the home
        // navigation button. Close it before trying BackMain.
        "max_hit": 3,
        "recognition": "OCR",
        "roi": [
            190,
            70,
            340,
            120
        ],
        "expected": "選擇擴充組|选择扩充组",
        "threshold": 0.65,
        "action": "Click",
        "target": [
            360,
            1205
        ],
        "post_delay": 3000,
        "next": [
            "CheckMain"
        ]
    }
}
