{
    "StartUp": {
        ///1.启动游戏
        // 2.点击进入游戏
        ///2.检查是否测到主页关键词 （得卡挑战，商店）
        ///3.关闭通知
        ///4.如果在抽卡页面，返回主页
        "post_wait_freezes": 300,
        "next": [
            "StartPTCG"
        ]
    },
    "StartPTCG": {
        "post_delay": 2000,
        "action": "StartApp",
        "package": "jp.pokemon.pokemontcgp",
        "next": [
            "[JumpBack]ClickPokemonLogo",
            "[JumpBack]NetworkError",
            "[JumpBack]CloseNotify",
            "[JumpBack]ClosePackIndex",
            "CheckMain",
            "[JumpBack]BackMain"
        ]
    },
    "ClickPokemonLogo": {
        // A permanently unchanged splash screen must not keep the task alive
        // forever. Two clicks cover the normal cold-start transition.
        "max_hit": 2,
        "recognition": "OCR",
        "expected": "Pocket",
        "roi": [
            160,
            660,
            400,
            100
        ],
        "threshold": 0.8,
        "action": "Click",
        "next": [
            // "CloseNotify",
            // "CheckStart"
        ],
        "post_delay": 2000
    },
    "CheckMain": {
        "recognition": "OCR",
        "expected": "得卡",
        "roi": [
            132,
            950,
            119,
            37
        ],
        "threshold": 0.8,
        "on_error": [
            "ClickPokemonLogo",
            "NetworkError",
            "CloseNotify",
            "ClosePackIndex",
            "CheckStart",
            "BackMain"
        ],
        "action": "DoNothing",
        "next": []
    },
    "CheckStart": {
        // The pack-detail sheet exposes "提供比例" and a large back button.
        // Leave through that button instead of relying on the dimmed home tab,
        // which can ignore taps while this sheet is active.
        "max_hit": 3,
        "recognition": "OCR",
        "expected": "提供比例",
        "roi": [
            60,
            1100,
            150,
            50
        ],
        "threshold": 0.8,
        "action": "LongPress",
        "target": [
            360,
            1118
        ],
        "duration": 1200,
        "post_delay": 3000,
        "next": [
            "CheckMain",
            "CheckStart",
            "BackMain"
        ]
    },
    "NetworkError": {
        // Authentication and network dialogs use different descriptions, but
        // their action button is consistently rendered as OK / retry here.
        // Bound the retries so a server outage cannot loop indefinitely.
        "max_hit": 3,
        "post_delay": 6000,
        "recognition": "OCR",
        "expected": "OK|再試一次|再试一次|重試|重试|一次",
        "roi": [
            240,
            820,
            240,
            150
        ],
        "threshold": 0.8,
        "action": "Click",
        "next": []
    },
